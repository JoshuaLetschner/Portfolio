# Öffentliche URL der Website (nur echte Domain eintragen, ohne Slash am Ende).
# Ohne Wert werden keine Canonical-URLs, keine Sitemap und keine absoluten OG-Bilder erzeugt.
SITE_URL=

# Produktionsbranch für die Preview-Erkennung (Standard: main)
# PRODUCTION_BRANCH=main

# "true" setzt den gesamten Build auf noindex
# SITE_NOINDEX=false
