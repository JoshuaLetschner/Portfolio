---
import SectionHead from './SectionHead.astro';
import { about } from '../data/profile';

const [lead, ...rest] = about;
---

<section class="section about" id="ueber-mich" aria-labelledby="ueber-mich-title">
  <div class="container">
    <SectionHead number="01" label="Über mich" title="Vom IT-Support in die Cloud." id="ueber-mich-title" />
    <div class="about__body">
      <p class="about__lead">{lead}</p>
      <div class="about__rest">
        {rest.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .about__body {
    display: grid;
    gap: 2rem;
  }

  .about__lead {
    font-size: var(--text-lg);
    line-height: 1.5;
    letter-spacing: -0.012em;
    max-width: 44rem;
  }

  .about__rest {
    display: grid;
    gap: 1.25rem;
    max-width: var(--measure);
    color: var(--color-muted);
    font-size: var(--text-md);
  }

  @media (min-width: 60rem) {
    .about__body {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: 2rem;
    }

    .about__lead,
    .about__rest {
      grid-column: 2;
    }
  }
</style>
