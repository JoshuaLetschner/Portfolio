---
import Icon from './Icon.astro';
import { contact, externalLinks, profile, publicCvUrl } from '../data/profile';

const profiles = [
  { label: 'GitHub', href: externalLinks.github },
  { label: 'LinkedIn', href: externalLinks.linkedin },
].filter((link): link is { label: string; href: string } => Boolean(link.href));
const hasExtras = profiles.length > 0 || Boolean(publicCvUrl);
---

<section class="contact" id="kontakt" aria-labelledby="kontakt-title">
  <div class="container contact__inner">
    <p class="contact__label"><span>06</span><span>Kontakt</span></p>
    <h2 id="kontakt-title" class="contact__title">
      {contact.heading.replace(/\.$/, '')}<span class="contact__dot">.</span>
    </h2>
    <p class="contact__text">{contact.text}</p>

    <div class="contact__mail">
      <a class="contact__address" href={`mailto:${profile.email}`}>
        <Icon name="mail" class="contact__mail-icon" />
        <span>{profile.email}</span>
      </a>
      <button class="contact__copy" type="button" data-copy-email={profile.email} data-requires-js>
        <Icon name="copy" class="contact__copy-icon" />
        <span data-copy-label>Adresse kopieren</span>
      </button>
      <p class="contact__status" role="status" aria-live="polite" data-copy-status></p>
    </div>

    {
      hasExtras && (
        <ul class="contact__profiles" role="list">
          {profiles.map((link) => (
            <li>
              <a class="text-link" href={link.href} rel="me noopener" target="_blank">
                {link.label}
                <Icon name="arrow-up-right" />
              </a>
            </li>
          ))}
          {publicCvUrl && (
            <li>
              <a class="text-link" href={publicCvUrl} download>
                Lebenslauf (PDF)
                <Icon name="arrow-right" />
              </a>
            </li>
          )}
        </ul>
      )
    }
  </div>
</section>

<style>
  .contact {
    background: var(--color-ink);
    color: var(--color-on-ink);
    padding-block: var(--section-space) clamp(4rem, 3rem + 4vw, 6rem);
  }

  .contact__inner {
    display: grid;
    justify-items: start;
  }

  .contact__label {
    display: flex;
    gap: 0.75rem;
    padding-top: 1.25rem;
    width: 100%;
    border-top: 1px solid var(--color-on-ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-on-ink-muted);
  }

  .contact__label span:first-child {
    color: var(--color-accent-on-ink);
  }

  .contact__title {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    max-width: 14ch;
    font-size: clamp(2.6rem, 1.5rem + 5vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .contact__dot {
    color: var(--color-accent-on-ink);
  }

  .contact__text {
    margin-top: 1.75rem;
    max-width: 36rem;
    color: var(--color-on-ink-muted);
    font-size: var(--text-md);
  }

  .contact__mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .contact__address {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 3rem;
    font-size: clamp(1.35rem, 1rem + 1.8vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-on-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-accent-on-ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
  }

  .contact__address:hover {
    color: var(--color-accent-on-ink);
  }

  .contact :global(.contact__mail-icon) {
    width: 1em;
    height: 1em;
    flex: none;
    color: var(--color-accent-on-ink);
  }

  .contact__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-on-ink-muted);
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-on-ink);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .contact__copy:hover {
    background: var(--color-on-ink);
    color: var(--color-ink);
  }

  .contact :global(.contact__copy-icon) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .contact__status {
    flex-basis: 100%;
    min-height: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-on-ink-muted);
  }

  .contact__profiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1rem;
  }

  .contact__profiles .text-link {
    color: var(--color-on-ink);
    text-decoration-color: var(--color-accent-on-ink);
  }

  .contact :focus-visible {
    outline-color: var(--color-accent-on-ink);
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  const label = button?.querySelector<HTMLElement>('[data-copy-label]');

  if (button && status && label) {
    if (!navigator.clipboard?.writeText) {
      // Ohne Clipboard-API bleibt nur der mailto-Link sichtbar.
      button.hidden = true;
    } else {
      let timer: number | undefined;
      button.addEventListener('click', async () => {
        const email = button.dataset.copyEmail ?? '';
        try {
          await navigator.clipboard.writeText(email);
          status.textContent = `E-Mail-Adresse ${email} kopiert.`;
          label.textContent = 'Kopiert';
        } catch {
          status.textContent = 'Kopieren nicht möglich – bitte die Adresse direkt markieren.';
        }
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          label.textContent = 'Adresse kopieren';
          status.textContent = '';
        }, 4000);
      });
    }
  }
</script>
