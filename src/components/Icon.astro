---
/**
 * Kleine Linien-Icons als Inline-SVG (keine Emojis, keine Icon-Fonts).
 */
interface Props {
  name: 'arrow-right' | 'arrow-left' | 'arrow-up-right' | 'copy' | 'check' | 'menu' | 'close' | 'mail';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-right' && <path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5" />}
  {name === 'arrow-left' && <path d="M20 12H5M10.5 6.5 5 12l5.5 5.5" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8.5 7H17v8.5" />}
  {name === 'copy' && <path d="M8.5 8.5h11v11h-11zM15.5 8.5v-4h-11v11h4" />}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'menu' && <path d="M4 8h16M4 16h16" />}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18" />}
  {name === 'mail' && <path d="M3.5 6h17v12h-17zM3.5 6.5l8.5 6.5 8.5-6.5" />}
</svg>
