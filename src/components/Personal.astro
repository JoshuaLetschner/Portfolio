---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { personal } from '../data/profile';
---

<section class="section personal" id="persoenlich" aria-labelledby="persoenlich-title">
  <div class="container">
    <SectionHead number="05" label="Persönlich" title="Neben der Arbeit" id="persoenlich-title" />

    <ul class="personal__list" role="list">
      {
        personal.map((item) => (
          <li class="personal__item">
            <svg class="personal__icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
              {item.icon === 'strategy' && (
                <>
                  <path class="stroke" d="m14 9 9 5.2v10.4L14 29.8l-9-5.2V14.2Z" />
                  <path class="stroke" d="m32 9 9 5.2v10.4L32 29.8l-9-5.2V14.2Z" />
                  <path class="stroke accent" d="m23 24.6 9 5.2v10.4L23 45.4l-9-5.2V29.8Z" />
                </>
              )}
              {item.icon === 'travel' && (
                <>
                  <circle class="stroke" cx="24" cy="24" r="17" />
                  <ellipse class="stroke" cx="24" cy="24" rx="7.5" ry="17" />
                  <path class="stroke" d="M7 24h34" />
                  <path class="stroke accent" d="M10 15.5h28" />
                </>
              )}
              {item.icon === 'build' && (
                <>
                  <path class="stroke" d="M7 11h34v26H7z" />
                  <path class="stroke" d="M7 18h34" />
                  <path class="stroke accent" d="m17 25-4.5 4.5L17 34M31 25l4.5 4.5L31 34" />
                </>
              )}
            </svg>
            <h3 class="personal__title">{item.title}</h3>
            <p class="personal__text">{item.text}</p>
            {'link' in item && item.link && (
              <a class="text-link" href={item.link.href}>
                {item.link.label}
                <Icon name="arrow-right" />
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .personal {
    background: var(--color-surface);
    border-block: 1px solid var(--color-line);
  }

  .personal__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 3rem clamp(1.5rem, 4vw, 4rem);
    margin: 0;
  }

  .personal__item {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.85rem;
  }

  .personal__icon {
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.5rem;
  }

  .stroke {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .stroke.accent {
    stroke: var(--color-accent);
  }

  .personal__title {
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }

  .personal__text {
    color: var(--color-muted);
    max-width: 26rem;
  }
</style>
