---
import CategoryMark from './CategoryMark.astro';
import Icon from './Icon.astro';
import ProjectIllustration from './ProjectIllustration.astro';
import SectionHead from './SectionHead.astro';
import {
  categoryDescriptions,
  categoryLabels,
  getProjects,
  projectUrl,
  statusLabels,
  type ProjectCategory,
} from '../lib/projects';

const projects = await getProjects();
const featured = projects.filter((project) => project.data.featured);
const others = projects.filter((project) => !project.data.featured);
const categories = Object.keys(categoryLabels) as ProjectCategory[];
const pad = (value: number) => String(value).padStart(2, '0');
---

<section class="section projects" id="projekte" aria-labelledby="projekte-title">
  <div class="container">
    <SectionHead number="02" label="Projekte" title="Projekte und Einblicke" id="projekte-title">
      <p>
        Sechs Einträge aus Beruf und Freizeit. Berufliche Themen beschreibe ich anonymisiert; die
        Kennzeichnung zeigt, worum es sich jeweils handelt.
      </p>
    </SectionHead>

    <ul class="legend" role="list" aria-label="Einordnung der Einträge">
      {
        categories.map((category) => (
          <li>
            <CategoryMark category={category} />
            <span>
              <strong>{categoryLabels[category]}</strong>
              <span class="legend__text">{categoryDescriptions[category]}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <ol class="featured" role="list">
      {
        featured.map((project, index) => (
          <li class:list={['feature', { 'feature--flip': index % 2 === 1 }]}>
            <article class="feature__inner" aria-labelledby={`projekt-${project.data.slug}`}>
              {project.data.illustration && (
                <div class="feature__visual">
                  <ProjectIllustration
                    name={project.data.illustration}
                    caption={project.data.illustrationCaption}
                    idPrefix={`home-${project.data.slug}`}
                  />
                </div>
              )}
              <div class="feature__text">
                <p class="meta">
                  <span class="meta__num">{pad(project.data.order)}</span>
                  <span class="meta__cat">
                    <CategoryMark category={project.data.category} />
                    {categoryLabels[project.data.category]}
                  </span>
                  <span class="meta__status">{statusLabels[project.data.status]}</span>
                </p>
                <h3 class="feature__title" id={`projekt-${project.data.slug}`}>
                  <a href={projectUrl(project)}>{project.data.title}</a>
                </h3>
                <p class="feature__summary">{project.data.summary}</p>
                <ul class="tech-list" role="list" aria-label="Themen">
                  {project.data.technologies.slice(0, 5).map((tech) => (
                    <li>{tech}</li>
                  ))}
                </ul>
                <span class="feature__more" aria-hidden="true">
                  Zum Projekt
                  <Icon name="arrow-right" />
                </span>
              </div>
            </article>
          </li>
        ))
      }
    </ol>

    <h3 class="index-heading">Weitere Einblicke</h3>
    <ol class="index" role="list">
      {
        others.map((project) => (
          <li class="index__row">
            <span class="index__num">{pad(project.data.order)}</span>
            <h4 class="index__title">
              <a href={projectUrl(project)}>{project.data.title}</a>
            </h4>
            <p class="index__summary">{project.data.summary}</p>
            <p class="index__cat">
              <CategoryMark category={project.data.category} />
              <span>
                {categoryLabels[project.data.category]}
                <span class="index__status">{statusLabels[project.data.status]}</span>
              </span>
            </p>
            <Icon name="arrow-right" class="index__arrow" />
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Legende */
  .legend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem 2rem;
    margin: 0 0 clamp(3rem, 2rem + 4vw, 5rem);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .legend li {
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
  }

  .legend strong {
    display: block;
    font-weight: 600;
  }

  .legend__text {
    color: var(--color-muted);
  }

  /* Meta-Zeile */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .meta__num {
    color: var(--color-accent);
  }

  .meta__cat {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
  }

  .meta__status {
    padding-left: 1.25rem;
    border-left: 1px solid var(--color-line);
  }

  /* Hervorgehobene Projekte */
  .featured {
    display: grid;
    gap: clamp(3.5rem, 2rem + 5vw, 6rem);
    margin: 0;
  }

  .feature__inner {
    position: relative;
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }

  .feature__text {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .feature__title {
    font-size: var(--text-xl);
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin-top: 0.25rem;
  }

  .feature__title a {
    text-decoration: none;
  }

  /* Ganze Karte klickbar, Link bleibt ein einziger, sauber benannter Link */
  .feature__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .feature__summary {
    max-width: 32rem;
    color: var(--color-muted);
    font-size: var(--text-md);
  }

  .feature__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-weight: 500;
    border-bottom: 1px solid var(--color-text);
    padding-bottom: 0.15rem;
  }

  .feature__more :global(svg) {
    width: 1.05em;
    height: 1.05em;
    transition: transform var(--duration) var(--ease);
  }

  .feature__inner:hover .feature__title a {
    color: var(--color-accent);
  }

  .feature__inner:hover .feature__more {
    border-color: var(--color-accent);
  }

  .feature__inner:hover .feature__more :global(svg) {
    transform: translateX(4px);
  }

  .feature__inner:has(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 0.75rem;
  }

  .feature__title a:focus-visible {
    outline: none;
  }

  @media (min-width: 56rem) {
    .feature__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }

    .feature--flip .feature__visual {
      order: 2;
    }

    .feature--flip .feature__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }

  /* Index-Liste */
  .index-heading {
    margin-top: clamp(4.5rem, 3rem + 5vw, 7rem);
    padding-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-text);
  }

  .index {
    margin: 0;
  }

  .index__row {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
    gap: 0.5rem 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .index__num {
    grid-row: 1;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    padding-top: 0.4rem;
  }

  .index__title {
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .index__title a {
    text-decoration: none;
  }

  .index__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .index__summary,
  .index__cat {
    grid-column: 2 / 3;
  }

  .index__summary {
    color: var(--color-muted);
  }

  .index__cat {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .index__status {
    display: block;
    margin-top: 0.15rem;
    color: var(--color-muted);
  }

  .index__row :global(.index__arrow) {
    grid-column: 3;
    grid-row: 1;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.3rem;
    transition: transform var(--duration) var(--ease), color var(--duration) var(--ease);
  }

  .index__row:hover .index__title a {
    color: var(--color-accent);
  }

  .index__row:hover :global(.index__arrow) {
    color: var(--color-accent);
    transform: translateX(4px);
  }

  .index__row:has(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 0.4rem;
  }

  .index__title a:focus-visible {
    outline: none;
  }

  @media (min-width: 56rem) {
    .index__row {
      grid-template-columns: 3.5rem minmax(0, 5fr) minmax(0, 6fr) minmax(0, 3.5fr) 1.5rem;
      gap: 2rem;
      padding: 1.75rem 0;
      align-items: start;
    }

    .index__summary {
      grid-column: 3;
      grid-row: 1;
    }

    .index__cat {
      grid-column: 4;
      grid-row: 1;
      padding-top: 0.35rem;
    }

    .index__row :global(.index__arrow) {
      grid-column: 5;
    }
  }
</style>
