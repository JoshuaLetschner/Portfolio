---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { externalLinks, profile } from '../data/profile';

interface Props {
  /** Seitentitel ohne Namenszusatz; leer = Startseite. */
  title?: string;
  description: string;
  /** Seite unabhängig vom Build auf noindex setzen (Entwürfe, 404). */
  noindex?: boolean;
  ogType?: 'website' | 'article' | 'profile';
  /** Person-Strukturdaten ausgeben (nur Startseite). */
  personSchema?: boolean;
}

const { title, description, noindex = false, ogType = 'website', personSchema = false } = Astro.props;

const fullTitle = title ? `${title} – ${profile.name}` : `${profile.name} – ${profile.role}`;
const site = Astro.site;
const indexable = __ALLOW_INDEXING__ && !noindex;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = site ? new URL('/og/joshua-letschner.png', site).href : undefined;

const sameAs = Object.values(externalLinks).filter((url): url is string => Boolean(url));
const personJsonLd = personSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.name,
      jobTitle: profile.role,
      worksFor: { '@type': 'Organization', name: profile.employer },
      email: `mailto:${profile.email}`,
      knowsLanguage: profile.languages.map((language) => language.code),
      ...(site ? { url: site.href } : {}),
      ...(sameAs.length > 0 ? { sameAs } : {}),
    }
  : undefined;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f5f2eb" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {!indexable && <meta name="robots" content={__ALLOW_INDEXING__ ? 'noindex' : 'noindex, nofollow'} />}
    {canonical && indexable && <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/geist-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={`${profile.name} – ${profile.role}`} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    {personJsonLd && <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />}

    <noscript><link rel="stylesheet" href="/noscript.css" /></noscript>
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <slot name="after-main" />
    <Footer />
  </body>
</html>
