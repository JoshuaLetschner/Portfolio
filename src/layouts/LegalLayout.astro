---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  /** false = sichtbarer Entwurf, noindex, nicht in der Sitemap. */
  ready: boolean;
}

const { title, description, ready } = Astro.props;
---

<BaseLayout title={ready ? title : `${title} (Entwurf)`} description={description} noindex={!ready}>
  <article class="container legal">
    {
      !ready && (
        <aside class="draft" aria-label="Hinweis zum Entwurf">
          <p class="draft__label">Entwurf</p>
          <p>
            Diese Seite ist technisch vorbereitet, aber noch nicht vollständig. Die tatsächlichen
            Angaben werden vor der öffentlichen Freigabe ergänzt und geprüft.
          </p>
        </aside>
      )
    }
    <h1 class="legal__title">{title}</h1>
    <div class="prose legal__body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .legal {
    padding-block: clamp(2.5rem, 2rem + 3vw, 4.5rem) var(--section-space);
  }

  .draft {
    max-width: var(--measure);
    margin-bottom: 2.5rem;
    padding: 1.1rem 1.25rem;
    border-left: 3px solid var(--color-accent);
    background: var(--color-surface);
    color: var(--color-muted);
  }

  .draft__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }

  .legal__title {
    font-size: var(--text-2xl);
    letter-spacing: -0.035em;
    margin-bottom: 2.5rem;
  }

  .legal__body :global(.todo) {
    display: inline-block;
    padding: 0.1rem 0.4rem;
    background: var(--color-wash);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
